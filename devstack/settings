# Quasar - impostazioni del plugin DevStack.

#nome del plugin, deve coincidere con local.conf
define_plugin quasar

#nome del servizio in esecuzione
enable_service quasar-api

#La cartella dove si trova il codice di quasar
QUASAR_DIR=${QUASAR_DIR:-$DEST/quasar}

#Il tipo con cui Quasar comparirà nel catalogo di Keystone
QUASAR_SERVICE_TYPE=${QUASAR_SERVICE_TYPE:-sensor}

# cartella dei file di configurazione di Quasar (come /etc/placement).
# fissa: keystonemiddleware cerca quasar.conf in /etc/quasar
QUASAR_CONF_DIR=/etc/quasar

# file di configurazione di Quasar, letto da keystonemiddleware
QUASAR_CONF=$QUASAR_CONF_DIR/quasar.conf

# app che deve caricare uWSGI
QUASAR_UWSGI=quasar.wsgi:application

# dove si trova il file di configurazione di uWSGI
QUASAR_UWSGI_CONF=$QUASAR_CONF_DIR/quasar-uwsgi.ini
